{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Suga Docs",
  "theme": "mint",
  "logo": {
    "light": "/logo/suga-light.svg",
    "dark": "/logo/suga-dark.svg"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#1D8740",
    "light": "#25b355",
    "dark": "#23A950"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://dashboard.suga.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://dashboard.suga.app/signup"
    }
  },
  "redirects": [
    { "source": "/concepts/networking", "destination": "/configure/networking" },
    { "source": "/concepts/deployments", "destination": "/operate/deployments" },
    { "source": "/reference/storage", "destination": "/configure/volumes" },
    {
      "source": "/reference/custom-domains",
      "destination": "/configure/custom-domains"
    },
    {
      "source": "/reference/private-registries",
      "destination": "/configure/private-registries"
    },
    { "source": "/reference/logs", "destination": "/operate/logs" },
    { "source": "/reference/observability", "destination": "/operate/metrics" },
    { "source": "/reference/mcp", "destination": "/agents/mcp" }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": ["introduction", "why-suga", "quickstart"]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/overview",
          "concepts/organizations",
          "concepts/projects",
          "concepts/environments",
          "concepts/services"
        ]
      },
      {
        "group": "Configure",
        "pages": [
          "configure/environment-variables",
          "reference/configuration",
          "configure/networking",
          "configure/volumes",
          "configure/custom-domains",
          "configure/private-registries"
        ]
      },
      {
        "group": "Operate",
        "pages": ["operate/deployments", "operate/logs", "operate/metrics"]
      },
      {
        "group": "Agents",
        "pages": ["agents/mcp"]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/billing",
          "reference/limits",
          "reference/cdn-and-regions",
          "reference/infrastructure-discipline",
          "reference/byoc-kubernetes"
        ]
      },
      {
        "group": "Comparisons",
        "pages": [
          "comparisons/suga-vs-vercel",
          "comparisons/suga-vs-railway",
          "comparisons/suga-vs-render"
        ]
      },
      {
        "group": "Support",
        "pages": [
          "support/troubleshooting",
          "support/contact",
          "support/side-projects",
          "support/faq"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/sugasrc",
